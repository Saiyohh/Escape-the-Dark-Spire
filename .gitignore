*.VC.db

# Unity build artifacts
*.apk
*.aab
*.ipa
*.unitypackage
*.app
ExportedObj/
.consulo/

# Crashlytics / analytics generated
crashlytics-build.properties

# Asset Store Tools plugin
[Aa]ssets/AssetStoreTools*

# Visual Scripting metadata
[Aa]ssets/[Aa]ssetStoreTools*
[Aa]ssets/Plugins/Editor/JetBrains*

# Unity package manager local cache
.upm-cache/

